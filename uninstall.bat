@echo off
chcp 65001 >nul
rem ============================================================
rem  УДАЛЕНИЕ «КНИЖНОГО СТРАЖА» (Windows)
rem  Удаление возможно ТОЛЬКО по паролю.
rem  Что удаляется: программа, резервная копия «стража»,
rem  автозапуск (приложение + страж), ярлыки, сама защита.
rem ============================================================
cd /d "%~dp0"
setlocal

echo ============================================================
echo   УДАЛЕНИЕ «КНИЖНОГО СТРАЖА»
echo ============================================================
echo.

set PY=python
if exist .venv\Scripts\python.exe set PY=.venv\Scripts\python.exe

%PY% -m bookguard uninstall --yes
if errorlevel 1 (
  echo.
  echo [x] Удаление не завершено (неверный пароль или ошибка).
  echo     Если программа уже повреждена - удалите папку вручную.
  pause
  exit /b 1
)

echo.
echo ============================================================
echo   УДАЛЕНО. Спасибо, что использовали «Книжный страж»!
echo ============================================================
echo  Файлы удалятся через несколько секунд (процесс уже выключен).
timeout /t 6 /nobreak >nul
endlocal
exit /b 0
